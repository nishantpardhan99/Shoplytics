# Shoplytics Environment Configuration
# Copy this file to .env and adjust variables as needed

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=shoplytics-super-secret-key-change-in-production-2026

# MySQL Database Settings
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=shoplytics_db

# Machine Learning Settings
LSTM_LOOKBACK_DAYS=30
LSTM_EPOCHS=25
LSTM_BATCH_SIZE=16
LSTM_FORECAST_HORIZON=14
